{:paths ["src"]
 :deps  {org.clojure/clojure {:mvn/version "1.12.0"}
         com.datomic/peer    {:mvn/version "1.0.7705"}
         ;; silence Datomic's slf4j chatter in the classroom
         org.slf4j/slf4j-nop {:mvn/version "2.0.13"}}
 :aliases
 {:repl {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}}
         :main-opts  ["-m" "nrepl.cmdline" "--interactive"]}
  ;; infrastructure class: peers need a JDBC driver to reach SQL storage
  :infra {:extra-deps {org.postgresql/postgresql {:mvn/version "42.5.1"}}}
  ;; session 1: the Client API, against a Peer Server
  :client {:extra-deps {com.datomic/client-pro {:mvn/version "1.0.81"}}}}}
